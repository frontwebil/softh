generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  category  Category
  title     String
  price     String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  category  String
  text      String
  date      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Category {
  consultation
  therapy
  surgery
  orthodontics
  pediatric
  prosthetics
}

model Lead {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  name       String
  phone      String
  message    String?
  contactWay String
}