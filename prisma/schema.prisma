generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  consultation
  therapy
  surgery
  orthodontics
  pediatric
  prosthetics
}

model Service {
  id        String        @id @default(cuid())
  order Int @default(0)
  category Category
  title String
  price String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())

  name        String
  category    String
  text        String   @db.Text
  date        String
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}